# Reference runtime (no model download or API key required)
GNSM_CONFIG=gnsm/configs/default.yaml
GNSM_SEED=42
GNSM_ARTIFACT_DIR=artifacts

# Optional Hugging Face training/generation integrations
HF_HOME=.cache/huggingface
GNSM_GENERATOR_MODEL=meta-llama/Llama-3.1-8B-Instruct
GNSM_TEXT_ENCODER=answerdotai/ModernBERT-large
WANDB_MODE=disabled
