# Local evaluation artifacts. Ignore raw per-run data (JSON) + run logs — they are
# regenerable — but KEEP the summary tables (.md/.csv) and plots (.png) the committed
# reports embed, so FAILURE_PROFILE_REPORT.md renders from a fresh clone.
evals/results/**/*.json
evals/results/**/*.log

# IDE / OS
.vscode/
.idea/
.DS_Store
Thumbs.db
